# Server Options
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8080
TIMEZONE=UTC
REQUIRE_HTTPS=false

# Persistent Storage Directory (SQLite DB and keys)
DATA_DIR=./data

# Security Secrets (Leave blank to auto-generate & persist in DATA_DIR)
