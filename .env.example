ENCRYPTION_KEY=
CSRF_SECRET=

# Mining Engine Defaults
POLL_INTERVAL_MINUTES=30
WATCH_HEARTBEAT_SECONDS=60
AUTO_CLAIM_DROPS=true
AUTO_FAILOVER_STREAMERS=true

# Twitch Client & Spade Endpoints (Configurable Constants)
